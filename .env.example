# Telegram @BotFather bergan token
TELEGRAM_BOT_TOKEN=
# https://console.anthropic.com -> API Keys
ANTHROPIC_API_KEY=
# Vositachi xizmat (masalan MWAPI) ishlatsangiz uning manzili: https://api.mwapi.dev
# Rasmiy Anthropic kaliti bo'lsa bo'sh qoldiring.
ANTHROPIC_BASE_URL=
# https://console.groq.com -> API Keys (ovozli xabarlar uchun, bepul)
GROQ_API_KEY=
# Neon (https://neon.tech) bergan Postgres manzili. Bo'sh bo'lsa lokal SQLite ishlatiladi.
DATABASE_URL=
# Botdan foydalanishga ruxsat berilgan Telegram ID lar (vergul bilan). Bo'sh bo'lsa, birinchi /start bosgan odam egasi bo'ladi.
OWNER_IDS=
# Ixtiyoriy
CLAUDE_MODEL=claude-opus-5-5
TIMEZONE=Asia/Tashkent
# Google Sheets (ixtiyoriy): Apps Script web-app manzili va unda yozilgan maxfiy so'z
SHEETS_WEBHOOK_URL=
SHEETS_SECRET=
